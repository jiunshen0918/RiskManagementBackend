# Copy these settings to .env and replace the placeholder locally.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=risk_management_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-postgresql-password

# Ollama Cloud client configuration (keep any Ollama credentials backend-only).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b-cloud

# Inclusive upper bounds for the application's risk severity bands.
RISK_LOW_MAX=4
RISK_MEDIUM_MAX=9
RISK_HIGH_MAX=16

# ServiceNow IRM OAuth client credentials (configure only in backend .env).
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_CLIENT_ID=replace-with-your-client-id
SERVICENOW_CLIENT_SECRET=replace-with-your-client-secret
